# ---------------------------------------------------------------------------
# CodeBase AI - environment configuration
# Copy to .env.local for local development; set the same keys in Vercel for deployment.
# Never commit real values.
# ---------------------------------------------------------------------------

# Public URL of the app (used for auth email redirect links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) -------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key - safe for the browser, all access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role (secret) key - SERVER ONLY. Used exclusively by the ingestion worker to write
# files/chunks/analyses after repository ownership has been verified. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chat model ---------------------------------------------------------------
# Set ONE provider key. Without any, analysis, explorer and architecture still work;
# chat and AI summaries are disabled.
# Anthropic: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: force a provider ("anthropic" | "groq"); otherwise the first key present is used.
AI_PROVIDER=
# Optional: defaults to claude-sonnet-5-5 (Anthropic) or openai/gpt-oss-120b (Groq).
# Must be a model that supports tool calling.
AI_CHAT_MODEL=

# --- Embeddings (OpenAI-compatible endpoint) ----------------------------------
# Optional. Enables semantic (pgvector) search; without it retrieval uses full-text + symbol search.
# The database column is vector(1536): pick a model that returns 1536 dimensions
# (OpenAI text-embedding-3-small does). EMBEDDING_BASE_URL lets you use another compatible provider.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=

# --- GitHub (optional) --------------------------------------------------------
# Public repositories work without a token. A fine-grained token with NO permissions (public read)
# raises the API rate limit from 60 to 5000 requests/hour. Private repo access is not enabled.
GITHUB_TOKEN=

# --- Limits (optional) --------------------------------------------------------
MAX_REPO_FILES=1500
MAX_REPO_TOTAL_MB=40
MAX_ARCHIVE_MB=50
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.25

# --- E2E tests (optional) -----------------------------------------------------
# E2E_REPO_URL=https://github.com/sindresorhus/is-plain-obj
# E2E_CHANNEL=chrome
